{
    "name": "3neti/emi-netbank",
    "description": "NetBank EMI provider adapter for emi-core",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Lester Hurtado",
            "email": "lester@hurtado.ph"
        }
    ],
    "autoload": {
        "psr-4": {
            "LBHurtado\\PaymentGateway\\": "src/",
            "LBHurtado\\PaymentGateway\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\PaymentGateway\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LBHurtado\\PaymentGateway\\PaymentGatewayServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.2",
        "3neti/emi-core": "^2.0@beta",
        "spatie/laravel-data": "^4.15",
        "laravel/sanctum": "^4.0",
        "lorisleiva/laravel-actions": "^2.9",
        "brick/money": "^0.10.1",
        "3neti/merchant": "^1.2",
        "3neti/laravel-model-channel": "^1.1",
        "3neti/wallet": "^1.0 || ^2.0@beta",
        "3neti/money-issuer": "^1.1",
        "propaganistas/laravel-phone": "^6.0",
        "league/omnipay": "^3.2",
        "omnipay/common": "^3.1",
        "php-http/guzzle7-adapter": "^1.0",
        "php-http/discovery": "^1.14"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.3 || ^11.0",
        "pestphp/pest": "^3.8 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.2 || ^4.0"
    },
    "scripts": {
        "pint": "vendor/bin/pint",
        "test": "vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
